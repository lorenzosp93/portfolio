# Development-only defaults. Replace placeholders locally; never commit secrets.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DATABASE_NAME=db.sqlite3
DB_ENGINE=django.db.backends.sqlite3
FRONTEND_HOST=http://localhost:8080
BACKEND_HOST=http://localhost:8000
DJANGO_LOGLEVEL=INFO
# Production examples:
# DJANGO_ALLOWED_HOSTS=lorenzosp.com,.lorenzosp.com,portfolio-origin.example.ts.net
# CSRF_TRUSTED_ORIGINS=https://lorenzosp.com,https://www.lorenzosp.com,https://portfolio-origin.example.ts.net
# AWS_S3_CUSTOM_DOMAIN=lorenzosp.com
