# Development-only defaults. Replace placeholders locally; never commit secrets.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DATABASE_NAME=db.sqlite3
DB_ENGINE=django.db.backends.sqlite3
FRONTEND_HOST=http://localhost:8080
BACKEND_HOST=http://localhost:8000
DJANGO_LOGLEVEL=INFO
# SMTP notifications (use a local app-specific password; never commit it):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_TO=me@lorenzosp.com
# EMAIL_FROM=me@lorenzosp.com
# EMAIL_HOST=smtp.mail.me.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-icloud-login@example.com
# EMAIL_HOST_PASSWORD=replace-with-app-specific-password
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=10
# CONTACT_EMAIL_MAX_ATTEMPTS=5
# CONTACT_EMAIL_RETRY_BASE_SECONDS=60
# CONTACT_EMAIL_LEASE_SECONDS=300
# CONTACT_EMAIL_POLL_SECONDS=5
# Production examples:
# DJANGO_ALLOWED_HOSTS=lorenzosp.com,.lorenzosp.com,portfolio-origin.example.ts.net
# CSRF_TRUSTED_ORIGINS=https://lorenzosp.com,https://www.lorenzosp.com,https://portfolio-origin.example.ts.net
# AWS_S3_CUSTOM_DOMAIN=lorenzosp.com
