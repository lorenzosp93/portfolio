{
  "name": "portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 8080",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint --ext .ts,.vue,.js --ignore-path .gitignore --fix src",
    "lint:check": "eslint --ext .ts,.vue,.js --ignore-path .gitignore src",
    "format": "prettier .  --write"
  },
  "dependencies": {
    "@heroicons/vue": "^2.0.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vueuse/core": "^9.12.0",
    "axios": "^1.3.3",
    "core-js": "^3.8.3",
    "gsap": "^3.12.2",
    "marked": "^12.0.2",
    "marked-katex-extension": "^5.0.1",
    "pinia": "^2.0.30",
    "vite": "^7.1.5",
    "vue": "^3.2.13",
    "vue-axios": "^3.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.9",
    "@types/marked": "^4.0.8",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@vue/test-utils": "^2.4.1",
    "autoprefixer": "^10.4.4",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-vue": "^8.7.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.10",
    "postcss": "^8.4.21",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^0.0.1-alpha.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.6"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "GSAPTimeline": "readonly"
    },
    "parser": "vue-eslint-parser",
    "extends": [
      "plugin:vue/base",
      "eslint:recommended",
      "plugin:vue/vue3-essential",
      "plugin:vue/vue3-recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier",
      "eslint-config-prettier"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "@typescript-eslint/parser",
      "ecmaVersion": "latest",
      "sourceType": "module",
      "extraFileExtensions": [
        ".vue"
      ]
    },
    "plugins": [
      "@typescript-eslint"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
